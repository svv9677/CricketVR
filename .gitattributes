# CricketVR — Git attributes
# Added 2026-09-21 (P4 repo hygiene).
#
# NOTE: no `filter=lfs` rules here on purpose — git-lfs is not installed on this
# machine. Adding LFS attributes without the binary present breaks checkout.
# See the commented LFS block at the bottom before enabling.

# ---------------------------------------------------------------------------
# Default: let git decide, but never touch anything it detects as binary.
# ---------------------------------------------------------------------------
*                   text=auto

# ---------------------------------------------------------------------------
# First-party source — normalise to LF in the repository.
# Current state is nearly clean: 4 files (AnimatedFielder, AnimatedFielderManagement,
# Ball, KeeperCollider) carry a single stray CR each; the rest are already pure LF.
# These rules are mainly to prevent future drift when editing from Windows.
# ---------------------------------------------------------------------------
*.cs                text eol=lf diff=csharp
*.shader            text eol=lf
*.cginc             text eol=lf
*.hlsl              text eol=lf
*.json              text eol=lf
*.xml               text eol=lf
*.md                text eol=lf
*.txt               text eol=lf
*.asmdef            text eol=lf
*.gitattributes     text eol=lf
*.gitignore         text eol=lf

# ---------------------------------------------------------------------------
# Unity YAML. Serialization mode is ForceText (EditorSettings.asset:7), so all
# of these are text. `-merge` stops git producing silently-corrupt auto-merges
# on scenes and prefabs — conflicts are surfaced for manual resolution instead.
# ---------------------------------------------------------------------------
*.meta              text eol=lf
*.unity             text eol=lf -merge
*.prefab            text eol=lf -merge
*.asset             text eol=lf
*.mat               text eol=lf
*.anim              text eol=lf
*.controller        text eol=lf
*.overrideController text eol=lf
*.physicMaterial    text eol=lf
*.physicmaterial    text eol=lf
*.mask              text eol=lf
*.rendertexture     text eol=lf
*.flare             text eol=lf
*.playable          text eol=lf
*.mixer             text eol=lf
*.terrainlayer      text eol=lf
*.signal            text eol=lf
*.guiskin           text eol=lf
*.fontsettings      text eol=lf
*.lighting          text eol=lf
*.shadervariants    text eol=lf
*.spriteatlas       text eol=lf
*.brush             text eol=lf
*.preset            text eol=lf

# ---------------------------------------------------------------------------
